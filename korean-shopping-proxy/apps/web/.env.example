# === Landing page (apps/web) environment ===
# Production domain is NOT finalized — configure all URLs/origins here.

# CMS public API base (server-side fetch at build/ISR time)
CMS_PUBLIC_URL=http://localhost:4000

# Shared secret for the on-demand revalidation route (must match apps/api)
REVALIDATE_SECRET=change-me-shared-with-api

# Public media base for next/image remotePatterns — full base incl. path, must match
# apps/api MEDIA_PUBLIC_BASE_URL. Only this host+path is allow-listed (e.g. /media/files/**).
# A declared-but-invalid value fails the build (fail-closed).
MEDIA_ORIGIN=http://localhost:4000/media/files

# Canonical site URL for SEO/metadata (env-driven; domain not finalized)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bounded timeout (ms) for the build/ISR content fetch (fail-closed on failure)
CMS_FETCH_TIMEOUT_MS=5000
