# === Admin dashboard (apps/admin) environment ===
# Production domain is NOT finalized — configure all URLs/origins here.

# CMS admin API base. v1 architecture = direct browser-to-API: admin Client Components
# call this URL with `credentials: 'include'` (cookie session) against a CORS allow-list.
# It is therefore exposed to the browser and MUST use the NEXT_PUBLIC_ prefix.
# (If a server-only variable is ever required, introduce an explicit BFF/Route Handler first.)
NEXT_PUBLIC_CMS_ADMIN_API_URL=http://localhost:4000

# Port for local dev (kept distinct from web:3000)
PORT=3001
