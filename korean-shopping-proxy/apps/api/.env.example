# === CMS API (apps/api) environment ===
# Production domain is NOT finalized — every URL/origin is configured here, not hardcoded.

# HTTP
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/vyvy

# Cookie-session admin auth (FR-025/FR-038)
SESSION_SECRET=change-me-in-every-environment
SESSION_COOKIE_NAME=vyvy_admin_session
SESSION_TTL_HOURS=12
# Set true in production (HTTPS). Leave false for local http.
SESSION_COOKIE_SECURE=false
# SameSite: lax | strict | none
SESSION_COOKIE_SAMESITE=lax

# Login throttling (FR-038): lock a username out for LOGIN_LOCKOUT_MINUTES after
# LOGIN_MAX_ATTEMPTS failed logins within LOGIN_ATTEMPT_WINDOW_MINUTES.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Express `trust proxy` — governs how req.ip is derived (the login throttle keys on
# it). Leave false for direct connections. Behind a reverse proxy set the hop count
# (e.g. 1) or trusted proxy IPs/subnets (e.g. loopback,10.0.0.0/8). Never `true` in prod.
TRUST_PROXY=false

# CSRF + CORS — comma-separated allowed origins (web + admin). No wildcards.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Media storage abstraction (FR-039). driver: local | s3 (v1 uses local)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/media
# Public base URL media is served from (used to build stable public URLs).
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media/files
# Upload limits
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_DIMENSION=6000
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp

# On-publish revalidation of the web app (FR-048)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-with-web
REVALIDATE_RETRIES=2

# Initial seeded admin (T015). Change before any real environment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-immediately
