{
  "name": "vyvy-order-korea",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @vyvy/content-types build && pnpm --filter web typecheck && pnpm --filter api build && pnpm --filter admin build",
    "test": "pnpm -r test",
    "security:scan": "pnpm audit --audit-level high",
    "launch:gate": "node scripts/launch-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "16.2.11",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@10.2.5>brace-expansion": "5.0.7",
      "fast-uri": "3.1.4",
      "glob": "10.5.0",
      "hono": "4.12.31",
      "js-yaml": "4.3.0",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "picomatch": "4.0.4",
      "sharp": "0.35.0",
      "tmp": "0.2.7"
    }
  }
}
